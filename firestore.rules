rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      function isOwner() {
        return signedIn() && request.auth.uid == userId;
      }

      function validNumber(data, key, min) {
        return !(key in data) || (data[key] is number && data[key] >= min);
      }

      function validProfile(data) {
        return (!('username' in data)
                  || (data.username is string && data.username.size() > 0 && data.username.size() <= 30))
          && validNumber(data, 'coins', 0)
          && validNumber(data, 'xp', 0)
          && validNumber(data, 'level', 1)
          && validNumber(data, 'elapsedTime', 0);
      }

      // The caller is the only uid added to or removed from this array.
      function onlySelfChanged(key) {
        let before = resource.data.get(key, []).toSet();
        let after = request.resource.data.get(key, []).toSet();
        return after.difference(before).hasOnly([request.auth.uid])
          && before.difference(after).hasOnly([request.auth.uid]);
      }

      function addsSelf(key) {
        return request.auth.uid in request.resource.data.get(key, [])
          && !(request.auth.uid in resource.data.get(key, []));
      }

      // Another user may only touch the friend fields, and only to add/remove themselves:
      // send/cancel a request, accept/reject one they received, or unfriend.
      function validFriendUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['friendRequests', 'sentRequests', 'friends'])
          && onlySelfChanged('friendRequests')
          && onlySelfChanged('sentRequests')
          && onlySelfChanged('friends')
          && !addsSelf('sentRequests')
          // Can only become this user's friend if this user sent you a request.
          && (!addsSelf('friends') || request.auth.uid in resource.data.get('sentRequests', []));
      }

      // Public because the register screen checks username availability before
      // signing in, and anyone can sign up anyway. Never store private data here.
      allow read: if true;
      allow create: if isOwner() && validProfile(request.resource.data);
      allow update: if (isOwner() && validProfile(request.resource.data))
                    || (signedIn() && !isOwner() && validFriendUpdate());
      allow delete: if false;
    }

    match /achievements/{achievementId} {
      allow read: if signedIn();
      // The achievement screen creates missing achievements on the fly.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'description', 'points', 'thresholdLevel'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100;
      allow update, delete: if false;
    }

    match /shopItems/{itemId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
